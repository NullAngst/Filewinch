/* Shared rules for every theme. @names come from each theme's palette block.
   A theme file may add its own rules below its palette; they load after these. */

QWidget {
    background: @bg;
    color: @fg;
    font-size: 10.5pt;
    selection-background-color: @accent;
    selection-color: @accent_fg;
}

QMainWindow, QDialog { background: @bg; }

#Sidebar {
    background: @panel;
    border: none;
    border-right: 1px solid @border;
    padding: 8px 0;
    outline: 0;
}
#Sidebar::item {
    padding: 9px 18px;
    border-left: 3px solid transparent;
    color: @muted;
}
#Sidebar::item:selected {
    background: @bg;
    color: @fg;
    border-left: 3px solid @accent;
}
#Sidebar::item:hover:!selected { color: @fg; }

#AppTitle { font-size: 15pt; font-weight: 600; color: @fg; padding: 14px 18px 6px 18px; background: @panel; }
#PageTitle { font-size: 16pt; font-weight: 600; padding-bottom: 4px; }
#Hint, QLabel[hint="true"] { color: @muted; }

QPushButton {
    background: @button;
    color: @fg;
    border: 1px solid @border;
    border-radius: 6px;
    padding: 6px 14px;
}
QPushButton:hover { border-color: @accent; }
QPushButton:pressed { background: @panel; }
QPushButton:disabled { color: @muted; background: @panel; border-color: @panel; }
QPushButton[primary="true"] { background: @accent; color: @accent_fg; border-color: @accent; font-weight: 600; }
QPushButton[primary="true"]:disabled { background: @panel; color: @muted; border-color: @panel; }
QPushButton[big="true"] { font-size: 13pt; padding: 18px 22px; text-align: left; border-radius: 10px; }

QLineEdit, QComboBox, QSpinBox, QDateEdit, QPlainTextEdit, QTextEdit {
    background: @input;
    color: @fg;
    border: 1px solid @border;
    border-radius: 5px;
    padding: 4px 6px;
}
QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus { border-color: @accent; }
QComboBox QAbstractItemView { background: @input; color: @fg; selection-background-color: @accent; }

QTreeView, QTreeWidget, QTableWidget, QListWidget {
    background: @input;
    alternate-background-color: @panel;
    border: 1px solid @border;
    border-radius: 5px;
    gridline-color: @border;
}
QHeaderView::section {
    background: @panel;
    color: @muted;
    border: none;
    border-bottom: 1px solid @border;
    padding: 5px 6px;
}

QProgressBar {
    background: @input;
    border: 1px solid @border;
    border-radius: 5px;
    text-align: center;
    color: @fg;
    min-height: 16px;
}
QProgressBar::chunk { background: @accent; border-radius: 4px; }

QGroupBox {
    border: 1px solid @border;
    border-radius: 8px;
    margin-top: 14px;
    padding: 10px;
}
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: @muted; }

QCheckBox, QRadioButton { spacing: 8px; background: transparent; }

QScrollBar:vertical { background: @bg; width: 11px; margin: 0; }
QScrollBar::handle:vertical { background: @border; border-radius: 5px; min-height: 24px; }
QScrollBar:horizontal { background: @bg; height: 11px; margin: 0; }
QScrollBar::handle:horizontal { background: @border; border-radius: 5px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }

QToolTip { background: @panel; color: @fg; border: 1px solid @border; padding: 4px; }

#DropZone {
    border: 2px dashed @border;
    border-radius: 10px;
    background: @panel;
    color: @muted;
    font-size: 12pt;
    padding: 24px;
}
#DropZone[hover="true"] { border-color: @accent; color: @fg; }

#Log { font-family: monospace; font-size: 9.5pt; background: @input; }

#Banner { border-radius: 6px; padding: 8px 10px; }
#Banner[level="warn"] { background: @warn_bg; color: @warn; border: 1px solid @warn; }
#Banner[level="error"] { background: @bad_bg; color: @bad; border: 1px solid @bad; }
#Banner[level="info"] { background: @panel; color: @fg; border: 1px solid @border; }
#Banner[level="ok"] { background: @panel; color: @good; border: 1px solid @good; }

/* Indicators. Without these, a stylesheet on QWidget leaves Fusion drawing
   check boxes and radio buttons nearly invisible on dark themes. */
QCheckBox::indicator, QTreeView::indicator, QListView::indicator, QTableView::indicator {
    width: 14px; height: 14px;
    border: 1px solid @muted;
    border-radius: 3px;
    background: @input;
}
QCheckBox::indicator:checked, QTreeView::indicator:checked, QListView::indicator:checked,
QTableView::indicator:checked {
    background: @accent;
    border-color: @accent;
    image: none;
}
QTreeView::indicator:indeterminate, QCheckBox::indicator:indeterminate {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 @accent, stop:0.5 @accent, stop:0.51 @input, stop:1 @input);
    border-color: @accent;
}
QRadioButton::indicator {
    width: 14px; height: 14px;
    border: 1px solid @muted;
    border-radius: 8px;
    background: @input;
}
QRadioButton::indicator:checked {
    background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0 @accent, stop:0.55 @accent, stop:0.6 @input, stop:1 @input);
    border-color: @accent;
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { border-color: @border; }
